# Production environment for menu.kostecki.dev.
# Copy to .env.prod on the VPS and fill the empty values. Never commit .env.prod.
# scripts/deploy.sh refuses to run unless these are set: APP_KEY, DB_PASSWORD, MAIL_HOST,
# MAIL_FROM_ADDRESS, LOG_ALERT_MAIL_TO, BACKUP_ARCHIVE_PASSWORD, BACKUP_NOTIFICATION_MAIL,
# APP_ENV=production, APP_DEBUG=false, INERTIA_SSR_ENABLED=false, AI_SCALING_DRIVER
# (openrouter needs OPENROUTER_API_KEY and OPENROUTER_MODEL; anthropic needs ANTHROPIC_API_KEY).

APP_NAME="Menu Maker"
APP_ENV=production
# Generate with: docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://menu.kostecki.dev
APP_LOCALE=pl
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=daily,mail_alert
LOG_LEVEL=info
LOG_DAILY_DAYS=14
# Recipient of error alert e-mails
LOG_ALERT_MAIL_TO=

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=menu_maker
DB_USERNAME=menu
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=menu.kostecki.dev

CACHE_STORE=database
CACHE_PREFIX=menu-maker-cache-
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@kostecki.dev"
MAIL_FROM_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

# Ingredient scaling refinement: openrouter or anthropic (fake is for tests only)
AI_SCALING_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Encrypted DB-only backups. Keep a copy of BACKUP_ARCHIVE_PASSWORD off the VPS too:
# without it the archives cannot be opened.
BACKUP_NAME=menu-maker
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_MAIL=
BACKUP_HOST_DIR=/storage/menu-maker-backups

VITE_APP_NAME="${APP_NAME}"
WWWUSER=1000
WWWGROUP=1000
